# ============================================================
# Google Analytics MCP — Environment Variables
# ============================================================
# NEVER commit this file with real values!
# Add .env to your .gitignore.
#
# Copy to .env and fill in with your real credentials:
#   cp .env.example .env
# ============================================================

# ── OAuth2 credentials (stdio mode only) ────────────────────
# Create a project at https://console.cloud.google.com/, enable the
# "Google Analytics Data API", and create OAuth 2.0 credentials of
# type "Desktop app". Then run:
#   uv run python scripts/get_refresh_token.py
GOOGLE_ANALYTICS_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_ANALYTICS_CLIENT_SECRET=your_client_secret
GOOGLE_ANALYTICS_REFRESH_TOKEN=your_refresh_token

# ── GA4 property ────────────────────────────────────────────
# Numeric property ID (no "properties/" prefix).
# Find it in: Analytics Admin > Property details.
# Can be overridden per tool call.
GOOGLE_ANALYTICS_PROPERTY_ID=123456789

# ── MCP server configuration ────────────────────────────────
# Transport: "stdio" (local) or "http" (multi-tenant remote server)
MCP_TRANSPORT=http

# Port for HTTP transport
MCP_PORT=8000

# Host (use 0.0.0.0 in Docker, 127.0.0.1 for local)
MCP_HOST=0.0.0.0

# HOST port mapped to the container (Docker Compose only).
# Useful when multiple checkouts (prod/staging) run on the same machine:
#   prod    → MCP_HOST_PORT=8000  (default, can omit)
#   staging → MCP_HOST_PORT=8001
# MCP_HOST_PORT=8000

# UID/GID owning the ./data bind mount (Docker Compose only).
# Find with `id -u` and `id -g`. If omitted the container runs as 1000:1000
# (the `mcp` user from the Dockerfile), which causes PermissionError on
# ./data/ when the host user's UID differs from 1000.
# HOST_UID=1000
# HOST_GID=1000

# ── Multi-tenant OAuth 2.1 (HTTP mode only) ─────────────────
# Public server URL — used in OAuth metadata and Google redirect_uri.
# Must EXACTLY match what is registered in Google Cloud Console.
MCP_PUBLIC_URL=https://mcp.your-domain.com

# OAuth Client of type "Web application" created in GCP (DIFFERENT from the
# Desktop client used in the stdio flow above). Authorized redirect URI in
# GCP: ${MCP_PUBLIC_URL}/auth/callback
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_WEB_CLIENT_SECRET=

# OPTIONAL: signing key used by the fastmcp GoogleProvider for MCP JWTs.
# If absent it is derived from client_secret via PBKDF2. Set this explicitly
# only if you want multiple replicas/processes to share issued tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# OAUTH_JWT_SIGNING_KEY=
