# ============================================================
# Google Analytics MCP — Variáveis de Ambiente
# ============================================================
# NUNCA commite este arquivo com valores reais!
# Copie para .env e preencha:
#   cp .env.example .env
# ============================================================

# ── Credenciais OAuth2 (Google Cloud Console) ──────────────
# 1. Crie um projeto em https://console.cloud.google.com/
# 2. Ative a "Google Analytics Data API"
# 3. Crie credenciais OAuth2 do tipo "Desktop app"
# 4. Execute: python scripts/get_refresh_token.py
GOOGLE_ANALYTICS_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_ANALYTICS_CLIENT_SECRET=seu_client_secret
GOOGLE_ANALYTICS_REFRESH_TOKEN=seu_refresh_token

# ── Propriedade GA4 ─────────────────────────────────────────
# ID numérico da propriedade GA4 (sem o prefixo "properties/")
# Encontrado em: Analytics Admin > Detalhes da propriedade
GOOGLE_ANALYTICS_PROPERTY_ID=123456789

# ── Configuração do servidor MCP ────────────────────────────
MCP_TRANSPORT=http
MCP_PORT=8000
MCP_HOST=0.0.0.0

# ── API Keys para acesso HTTP (opcional) ────────────────────
# Formato JSON: [{"key": "sk-ga-abc...", "user": "ana.silva", "description": "Equipe marketing"}]
# ALLOWED_API_KEYS=[{"key":"sk-ga-abc123","user":"default","description":"Acesso local"}]

# Ou chave única simples:
# MCP_API_KEY=sk-ga-sua-chave-aqui

# ── Arquivo externo de chaves (alternativa) ──────────────────
# API_KEYS_FILE=/etc/google-analytics-mcp/keys.json
